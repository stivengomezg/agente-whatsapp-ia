# Negocio a cargar (carpeta dentro de negocios/). demo = datos ficticios
NEGOCIO=demo

# --- IA ---
ANTHROPIC_API_KEY=
MODELO=claude-sonnet-5-5
MODELO_RAPIDO=claude-haiku-5-5
MAX_RONDAS_HERRAMIENTAS=6
MENSAJES_EN_CONTEXTO=12

# --- Base PROPIA del agente: memoria, solicitudes, escalamientos, métricas ---
# Local: sqlite:///agente.db   Producción: postgresql+psycopg://usuario:clave@host:5432/agente
AGENTE_DB_URL=sqlite:///agente.db

# --- Conexión de SOLO LECTURA al sistema del negocio (usuario creado por el script del conector) ---
CONECTOR_DB_URL=

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Panel web del negocio (/panel) ---
PANEL_USUARIO=admin
PANEL_CLAVE=

# --- Proveedor del agente: suspender, fecha de prueba (/admin) ---
ADMIN_TOKEN=

# --- Avisos (webhook de Slack, Discord, Google Chat, etc.) ---
ALERTA_WEBHOOK_URL=     # errores técnicos, al desarrollador
EQUIPO_WEBHOOK_URL=     # escalamientos y solicitudes, al equipo del negocio

LIMITE_MENSAJES_10_MIN=20
